rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isModerator() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }
    
    function isTeacher() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        isAdmin() ||
        isModerator()
      );
    }
    
    function isValidNoteData() {
      return request.resource.data.keys().hasAll([
        'title', 'courseCode', 'universityId', 'departmentId', 
        'semester', 'authorName', 'status', 'createdAt', 'createdBy'
      ]) &&
      request.resource.data.title is string &&
      request.resource.data.courseCode is string &&
      request.resource.data.universityId is string &&
      request.resource.data.departmentId is string &&
      request.resource.data.semester is number &&
      request.resource.data.semester >= 1 &&
      request.resource.data.semester <= 8 &&
      request.resource.data.authorName is string &&
      request.resource.data.status in ['pending', 'approved', 'rejected'] &&
      request.resource.data.createdBy is string;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Allow creation with any role for authenticated users (admin setup)
      allow create: if request.resource.data.uid == userId &&
                       request.resource.data.keys().hasAll(['uid', 'email']) &&
                       request.resource.data.uid is string &&
                       request.resource.data.email is string;
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdAt', 'emailVerified']) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Universities collection
    match /universities/{universityId} {
      // Anyone can read active universities
      allow read: if resource.data.active == true;
      // Admins can read all universities
      allow read: if isAdmin();
      // Only admins can create, update, or delete universities
      allow create, update, delete: if isAdmin();
    }
    
    // Departments collection
    match /departments/{departmentId} {
      // Anyone can read active departments
      allow read: if resource.data.active == true;
      // Admins can read all departments
      allow read: if isAdmin();
      // Only admins can create, update, or delete departments
      allow create, update, delete: if isAdmin();
    }
    
    // Helper function to check if user has paid for a note
    function hasUserPaidForNote(noteId, userId) {
      return exists(/databases/$(database)/documents/payments/$(userId + '_' + noteId)) ||
             exists(/databases/$(database)/documents/payments/$(noteId + '_' + userId));
    }
    
    // Helper function to check if user can access note (free or paid)
    function canAccessNote(noteId) {
      let noteData = resource.data;
      let isFreeNote = !('price' in noteData) || noteData.price == 0;
      let hasPaid = hasUserPaidForNote(noteId, request.auth.uid);
      let isOwner = noteData.createdBy == request.auth.uid;
      
      return isFreeNote || hasPaid || isOwner || isAdmin();
    }
    
    // Notes collection
    match /notes/{noteId} {
      // Anyone can read approved notes metadata (title, description, price, etc.)
      // But file URL access is controlled separately
      allow read: if resource.data.status == 'approved';
      
      // Owners can read their own notes regardless of status
      allow read: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      
      // Admins, moderators, and teachers can read all notes
      allow read: if isTeacher();
      
      // Only admins can create notes
      allow create: if isAdmin() && 
                       isValidNoteData() &&
                       request.resource.data.createdBy == request.auth.uid;
      
      // Only admins can update notes (except system fields)
      allow update: if isAdmin() && 
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['createdAt', 'downloads', 'ratingAvg', 'ratingCount']);
      
      // Only admins can delete notes
      allow delete: if isAdmin();
      
      // System updates for downloads, ratings, and revenue (special case)
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['downloads']) ||
                    request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['ratingAvg', 'ratingCount']) ||
                    request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['totalRevenue', 'purchaseCount']);
    }
    
    // AI Jobs collection
    match /aiJobs/{jobId} {
      // Users can only read/write their own AI jobs
      allow read: if isOwner(resource.data.createdBy) || isAdmin();
      allow create: if isSignedIn() && 
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isOwner(resource.data.createdBy);
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();
    }
    
    // Internships collection
    match /internships/{internshipId} {
      allow read: if true; // Public read
      allow create: if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    
    // Videos collection
    match /videos/{videoId} {
      allow read: if true; // Public read
      allow create: if isModerator();
      allow update: if isModerator();
      allow delete: if isAdmin();
    }
    
    // Analytics collection
    match /analytics/{docId} {
      // Only admins can read analytics
      allow read: if isAdmin();
      // System can create/update analytics
      allow create, update: if true;
      allow delete: if false; // Never delete analytics
    }
    
    // Admin logs collection
    match /adminLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();
      // System can create logs
      allow create: if true;
    }
    
    // Bookmarks subcollection under users
    match /users/{userId}/bookmarks/{bookmarkId} {
      // Users can manage their own bookmarks
      allow read, create, delete: if isOwner(userId);
      
      // Bookmarks can only be for approved notes
      allow create: if isOwner(userId) &&
                       exists(/databases/$(database)/documents/notes/$(request.resource.data.noteId)) &&
                       get(/databases/$(database)/documents/notes/$(request.resource.data.noteId)).data.status == 'approved';
    }
    
    // Ratings subcollection under notes
    match /notes/{noteId}/ratings/{userId} {
      // Users can read all ratings for approved notes
      allow read: if exists(/databases/$(database)/documents/notes/$(noteId)) &&
                     get(/databases/$(database)/documents/notes/$(noteId)).data.status == 'approved';
      
      // Users can create/update their own ratings for approved notes
      allow create, update: if isSignedIn() && 
                              userId == request.auth.uid &&
                              exists(/databases/$(database)/documents/notes/$(noteId)) &&
                              get(/databases/$(database)/documents/notes/$(noteId)).data.status == 'approved' &&
                              request.resource.data.rating is number &&
                              request.resource.data.rating >= 1 &&
                              request.resource.data.rating <= 5;
      
      // Users can delete their own ratings
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
    
    // Comments subcollection under notes
    match /notes/{noteId}/comments/{commentId} {
      allow read: if get(/databases/$(database)/documents/notes/$(noteId)).data.status == 'approved';
      allow create: if isSignedIn() && 
                       get(/databases/$(database)/documents/notes/$(noteId)).data.status == 'approved' &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isModerator();
    }
    
    // Payments collection
    match /payments/{paymentId} {
      // Users can read their own payment records
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Admins can read all payment records
      allow read: if isAdmin();
      
      // Users can create payment records (when making payments)
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['userId', 'noteId', 'amount', 'status']);
      
      // Only admins can update/delete payment records
      allow update, delete: if isAdmin();
    }
    
    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
