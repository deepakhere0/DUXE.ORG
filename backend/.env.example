# ==================================
# Backend Environment Variables
# ==================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ----------------------------------
# Server Configuration
# ----------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ----------------------------------
# Razorpay Payment Gateway
# ----------------------------------
# IMPORTANT: These are BACKEND keys (Key Secret) - NEVER expose in frontend

# Test Mode (for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Live Mode (for production)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_key_secret_here

# Webhook Secret (for payment notifications)
# Generate this in Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ----------------------------------
# OpenAI API (for AI features)
# ----------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ==================================
# RAZORPAY SETUP INSTRUCTIONS
# ==================================
# 
# 1. CREATE RAZORPAY ACCOUNT:
#    - Go to https://razorpay.com
#    - Sign up with your email/phone
#    - Complete basic registration
#
# 2. GET API KEYS:
#    - Go to Dashboard > Settings > API Keys
#    - Click "Generate Test Key" (for development)
#    - Copy both Key ID and Key Secret
#    - Add them to this .env file
#
# 3. ADD BANK ACCOUNT (for receiving payments):
#    - Go to Dashboard > Settings > Bank Accounts
#    - Click "Add Bank Account"
#    - Enter your individual bank account details:
#      * Account Holder Name
#      * Account Number
#      * IFSC Code
#      * Account Type (Savings/Current)
#    - Verify account (may take 1-2 business days)
#
# 4. COMPLETE KYC (for live mode):
#    - Go to Dashboard > Settings > Business Settings
#    - Upload required documents:
#      * PAN Card
#      * Address Proof
#      * Business Proof (if applicable)
#    - Wait for approval (usually 24-48 hours)
#
# 5. GENERATE LIVE KEYS (after KYC approval):
#    - Go to Dashboard > Settings > API Keys
#    - Click "Generate Live Key"
#    - Copy and securely store both keys
#    - Update .env file when deploying to production
#
# 6. CONFIGURE WEBHOOK (recommended):
#    - Go to Dashboard > Settings > Webhooks
#    - Click "Add New Webhook"
#    - Set URL: https://yourdomain.com/api/payments/webhook
#    - Select events: payment.captured, payment.failed
#    - Copy the webhook secret
#    - Add to RAZORPAY_WEBHOOK_SECRET in .env
#
# 7. PAYMENT FLOW:
#    - User clicks "Buy" on your platform
#    - Frontend calls backend: POST /api/payments/create-order
#    - Backend creates Razorpay order using Key Secret
#    - Frontend opens Razorpay checkout modal
#    - User completes payment through Razorpay
#    - Money is deposited to your bank account
#    - Razorpay handles settlements (T+2 days by default)
#
# SECURITY NOTES:
# ✅ Key Secret should ONLY be in backend .env
# ✅ Never expose Key Secret in frontend code
# ✅ Use test keys for development
# ✅ Use live keys only in production
# ✅ Verify payment signatures before granting access
# ✅ Set up webhooks for real-time payment notifications
#
# SETTLEMENTS:
# - Razorpay automatically transfers money to your bank account
# - Default settlement cycle: T+2 days (2 working days after payment)
# - You can track settlements in Dashboard > Settlements
# - Settlement charges: 2% + GST (standard pricing)
