{
  "name": "duxe-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:init": "node scripts/run-init.js",
    "db:setup": "echo 'Setting up Firestore database...' && npm run db:init",
    "create-admin": "node scripts/create-admin-manual.js",
    "create-admin:auto": "node scripts/create-admin-cli.js",
    "create-admin:emulator": "node scripts/create-admin-cli.js --emulator",
    "check-env": "node scripts/check-env.js",
    "emulator:start": "firebase emulators:start --only firestore,auth",
    "emulator:setup": "firebase emulators:start --only firestore,auth --import ./firebase-export --export-on-exit ./firebase-export"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "html2canvas": "^1.4.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.456.0",
    "mammoth": "^1.11.0",
    "openai": "^6.3.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-pdf": "^9.1.0",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}
