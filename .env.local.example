# ==================================
# DUXE Platform - Environment Variables
# ==================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ----------------------------------
# Firebase Configuration
# ----------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ----------------------------------
# Razorpay Payment Gateway
# ----------------------------------
# Test Mode Keys (for development)
# Get these from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxx
# Note: Key Secret should NEVER be exposed in frontend
# Only Key ID is needed in frontend for checkout

# Production Mode Keys (for live deployment)
# IMPORTANT: Only use these in production environment
VITE_RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxx

# Company Logo URL (optional - shown in Razorpay checkout)
VITE_COMPANY_LOGO_URL=https://yourdomain.com/logo.png

# ----------------------------------
# OpenAI API (for AI features)
# ----------------------------------
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ----------------------------------
# Backend API URL (if applicable)
# ----------------------------------
VITE_API_BASE_URL=http://localhost:3000/api

# ==================================
# RAZORPAY SETUP INSTRUCTIONS
# ==================================
# 1. Sign up at https://razorpay.com
# 2. Go to Dashboard > Settings > API Keys
# 3. Generate Test Keys for development
# 4. Copy Key ID to VITE_RAZORPAY_TEST_KEY_ID
# 5. For production:
#    - Complete KYC verification
#    - Generate Live Keys
#    - Copy Live Key ID to VITE_RAZORPAY_LIVE_KEY_ID
#    - Set up webhook for payment verification (optional but recommended)
#
# SECURITY NOTES:
# - Key Secret should ONLY be used in backend/server-side code
# - Never expose Key Secret in frontend code
# - Use environment-specific keys (test for dev, live for prod)
# - Validate payments on backend before granting access
