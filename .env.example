# ==================================
# DUXE Platform - Environment Variables
# ==================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ----------------------------------
# Firebase Configuration
# ----------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ----------------------------------
# Razorpay Payment Gateway
# ----------------------------------
# Frontend only needs the public Key ID (never the secret)
VITE_RAZORPAY_LIVE_KEY_ID=rzp_live_xxxxxxxxxxxxx
VITE_RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxx
VITE_COMPANY_LOGO_URL=https://yourdomain.com/logo.png

# ----------------------------------
# Backend API
# ----------------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# ----------------------------------
# Firebase Data Connect
# ----------------------------------
VITE_FIREBASE_DATACONNECT_SERVICE_ID=student-platform
VITE_FIREBASE_DATACONNECT_LOCATION=us-central1

# ----------------------------------
# Local Development
# ----------------------------------
VITE_USE_EMULATOR=false
VITE_DATACONNECT_EMULATOR_HOST=localhost
VITE_DATACONNECT_EMULATOR_PORT=9399
